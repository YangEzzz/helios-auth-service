# Existing remote PostgreSQL; no local database installation needed.
PORT=3456
GIN_MODE=release
DB_HOST=your-existing-db-server
DB_PORT=5433
DB_USER=your-db-user
DB_PASSWORD=replace-locally
DB_NAME=system_db
DB_SSLMODE=disable
DB_AUTO_MIGRATE=false
JWT_SECRET=replace-with-your-existing-secret
FRONTEND_URL=https://helios.team-tool.top
COOKIE_SECURE=true
TRUSTED_PROXIES=127.0.0.1,::1
